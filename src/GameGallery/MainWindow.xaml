<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameGallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GameGallery.Models"
    xmlns:converters="using:GameGallery.Converters"
    xmlns:views="using:GameGallery.Views"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRescanAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusSearchAccelerator" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAllAccelerator" />
            <KeyboardAccelerator Key="F" Invoked="OnFavoriteAccelerator" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="OnCopyAccelerator" />
            <KeyboardAccelerator Key="O" Invoked="OnRevealAccelerator" />
            <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
            <KeyboardAccelerator Key="Enter" Invoked="OnOpenViewerAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- ═══ 左侧导航（游戏标签） + 右侧内容 ═══ -->
        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            CompactPaneLength="52"
            MenuItemContainerStyle="{StaticResource TallNavItemStyle}"
            OpenPaneLength="248"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel
                    Margin="4,8,0,12"
                    Orientation="Horizontal"
                    Spacing="10">
                    <FontIcon
                        FontSize="18"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8B9;"
                        VerticalAlignment="Center" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="游戏截图图库" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Grid
                    Grid.Row="0"
                    Padding="16,12,16,8"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="0"
                        Width="240"
                        PlaceholderText="搜索文件名"
                        QueryIcon="Find"
                        TextChanged="OnSearchTextChanged" />

                    <TextBlock
                        x:Name="CountText"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="缩略图" />

                    <!-- Minimum/Maximum 在代码里设置：XAML 不保证属性赋值顺序，
                         若 Minimum 先于 Maximum 被赋值会与 Slider 默认的 Maximum=100 冲突。 -->
                    <Slider
                        x:Name="SizeSlider"
                        Grid.Column="3"
                        Width="130"
                        StepFrequency="20"
                        VerticalAlignment="Center"
                        ValueChanged="OnThumbnailSizeChanged" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="RescanButton"
                            AutomationProperties.Name="重新扫描"
                            Click="OnRescanClick"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="重新扫描 (F5)">
                            <FontIcon x:Name="RescanIcon" FontSize="15" Glyph="&#xE72C;" />
                        </Button>

                        <Button
                            AutomationProperties.Name="设置"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="设置">
                            <FontIcon FontSize="15" Glyph="&#xE713;" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <ScrollViewer MaxHeight="560" MaxWidth="480" HorizontalScrollMode="Disabled">
                                        <StackPanel Width="430" Spacing="14">
                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="显示" />

                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Width="80"
                                                    VerticalAlignment="Center"
                                                    Text="主题" />
                                                <ComboBox
                                                    x:Name="ThemeBox"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    SelectionChanged="OnThemeChanged">
                                                    <ComboBoxItem Content="跟随系统" />
                                                    <ComboBoxItem Content="浅色" />
                                                    <ComboBoxItem Content="深色" />
                                                </ComboBox>
                                            </Grid>

                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Width="80"
                                                    VerticalAlignment="Center"
                                                    Text="排序" />
                                                <ComboBox
                                                    x:Name="SortBox"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Stretch"
                                                    SelectionChanged="OnSortChanged">
                                                    <ComboBoxItem Content="拍摄时间（新 → 旧）" />
                                                    <ComboBoxItem Content="拍摄时间（旧 → 新）" />
                                                    <ComboBoxItem Content="文件名" />
                                                    <ComboBoxItem Content="文件大小（大 → 小）" />
                                                </ComboBox>
                                            </Grid>

                                            <ToggleSwitch
                                                x:Name="WatchToggle"
                                                Header="自动刷新"
                                                OffContent="关闭"
                                                OnContent="截图文件夹有变化时自动刷新"
                                                Toggled="OnWatchToggled" />

                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Text="截图文件夹" />
                                                <Button
                                                    Grid.Column="1"
                                                    Click="OnAddFolderClick"
                                                    ToolTipService.ToolTip="手动添加一个截图文件夹">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                                                        <TextBlock Text="添加" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <ItemsControl ItemsSource="{x:Bind FolderSummaries, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:FolderSummary">
                                                        <Border
                                                            Margin="0,0,0,6"
                                                            Padding="10,8"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                            CornerRadius="6">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind GameName}" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind Path}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                        Text="{x:Bind DetailText}" />
                                                                </StackPanel>
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Width="30" Height="30" Padding="0"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Click="OnOpenFolderClick"
                                                                    IsEnabled="{x:Bind Exists}"
                                                                    Tag="{x:Bind Path}"
                                                                    ToolTipService.ToolTip="打开文件夹">
                                                                    <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                                                                </Button>
                                                                <Button
                                                                    Grid.Column="2"
                                                                    Width="30" Height="30" Padding="0"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Click="OnRemoveFolderClick"
                                                                    Tag="{x:Bind Path}"
                                                                    ToolTipService.ToolTip="移除此文件夹"
                                                                    Visibility="{x:Bind converters:Bind.Visible(IsManual)}">
                                                                    <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Expander Header="定位详情（游戏目录从哪里来）">
                                                <ItemsControl ItemsSource="{x:Bind Diagnostics, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <TextBlock
                                                                Margin="0,2"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind}"
                                                                TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>

                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Click="OnRescanClick" Content="重新扫描" />
                                                <Button Click="OnClearThumbnailCacheClick" Content="清理缩略图缓存" />
                                                <Button Click="OnOpenConfigFolderClick" Content="打开配置目录" />
                                            </StackPanel>

                                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="关于" />

                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Width="80"
                                                    VerticalAlignment="Center"
                                                    Text="当前版本" />
                                                <TextBlock
                                                    x:Name="VersionText"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="VersionText"
                                                    Text="—" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button
                                                    x:Name="CheckUpdateButton"
                                                    AutomationProperties.AutomationId="CheckUpdateButton"
                                                    Click="OnCheckUpdateClick"
                                                    Content="检查更新" />
                                                <Button
                                                    x:Name="InstallUpdateButton"
                                                    AutomationProperties.AutomationId="InstallUpdateButton"
                                                    Click="OnInstallUpdateClick"
                                                    Content="下载并安装"
                                                    Visibility="Collapsed" />
                                                <Button
                                                    x:Name="OpenReleaseButton"
                                                    AutomationProperties.AutomationId="OpenReleaseButton"
                                                    Click="OnOpenReleaseClick"
                                                    Content="打开发布页"
                                                    Visibility="Collapsed" />
                                                <Button Click="OnOpenChangelogClick" Content="更新日志" />
                                            </StackPanel>

                                            <TextBlock
                                                x:Name="UpdateStatusText"
                                                AutomationProperties.AutomationId="UpdateStatusText"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />

                                            <ProgressBar
                                                x:Name="UpdateProgress"
                                                AutomationProperties.AutomationId="UpdateProgress"
                                                Height="4"
                                                Maximum="100"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 缩略图网格 -->
                <Grid Grid.Row="1">
                    <GridView
                        x:Name="PhotoGrid"
                        Padding="12,0,12,12"
                        ContainerContentChanging="OnContainerContentChanging"
                        DoubleTapped="OnGridDoubleTapped"
                        ItemContainerStyle="{StaticResource PhotoTileContainerStyle}"
                        SelectionChanged="OnGridSelectionChanged"
                        SelectionMode="Extended"
                        SizeChanged="OnGridViewSizeChanged"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid CacheLength="4" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:PhotoItem">
                                <!-- Tag 用来把数据项交给右键菜单：ContextFlyout 不在可视树里，
                                     它和模板根的 DataContext 都拿不到，x:Bind 却是可靠的。 -->
                                <Grid
                                    Margin="5"
                                    AutomationProperties.Name="{x:Bind FileName}"
                                    RightTapped="OnTileRightTapped"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind ToolTipText}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="OnTileRevealClick" Text="在资源管理器中显示">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="OnTileCopyClick" Text="复制到剪贴板">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <Image x:Name="TileImage" Stretch="Uniform" />
                                    </Border>

                                    <Grid Grid.Row="1" Margin="3,6,3,0" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ShortDateText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <FontIcon
                                            Grid.Column="1"
                                            FontSize="11"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE735;"
                                            Visibility="{x:Bind converters:Bind.Visible(IsFavorite), Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel
                        x:Name="EmptyState"
                        MaxWidth="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="Collapsed">
                        <FontIcon
                            FontSize="38"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8B9;" />
                        <TextBlock
                            x:Name="EmptyStateText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ProgressRing
                        x:Name="BusyRing"
                        Width="56" Height="56"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsActive="False" />
                </Grid>

                <!-- 状态栏与操作按钮 -->
                <Grid
                    Grid.Row="2"
                    Padding="16,8,16,10"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="FavoriteActionButton"
                            AutomationProperties.Name="收藏"
                            Click="OnToggleFavoriteClick"
                            IsEnabled="False"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="收藏 / 取消收藏 (F)">
                            <FontIcon FontSize="15" Glyph="&#xE734;" />
                        </Button>
                        <Button
                            x:Name="CopyActionButton"
                            AutomationProperties.Name="复制到剪贴板"
                            Click="OnCopyClick"
                            IsEnabled="False"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="复制到剪贴板 (Ctrl+C)">
                            <FontIcon FontSize="15" Glyph="&#xE8C8;" />
                        </Button>
                        <Button
                            x:Name="RevealActionButton"
                            AutomationProperties.Name="在资源管理器中显示"
                            Click="OnRevealClick"
                            IsEnabled="False"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="在资源管理器中显示 (O)">
                            <FontIcon FontSize="15" Glyph="&#xE8B7;" />
                        </Button>
                        <Button
                            x:Name="OpenActionButton"
                            AutomationProperties.Name="用默认应用打开"
                            Click="OnOpenWithDefaultAppClick"
                            IsEnabled="False"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="用默认应用打开">
                            <FontIcon FontSize="15" Glyph="&#xE8E5;" />
                        </Button>
                        <Button
                            x:Name="DeleteActionButton"
                            AutomationProperties.Name="删除到回收站"
                            Click="OnDeleteClick"
                            IsEnabled="False"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="删除到回收站 (Delete)">
                            <FontIcon FontSize="15" Glyph="&#xE74D;" />
                        </Button>
                        <AppBarSeparator />
                        <Button
                            x:Name="SelectAllButton"
                            AutomationProperties.Name="全选"
                            Click="OnSelectAllClick"
                            Style="{StaticResource ToolIconButtonStyle}"
                            ToolTipService.ToolTip="全选 (Ctrl+A)">
                            <FontIcon FontSize="15" Glyph="&#xE8B3;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- ═══ 大图查看器覆盖层 ═══ -->
        <views:PhotoViewer
            x:Name="Viewer"
            Visibility="Collapsed" />
    </Grid>
</Window>
