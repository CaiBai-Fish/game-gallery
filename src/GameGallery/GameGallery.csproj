<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GameGallery</RootNamespace>
    <AssemblyName>GameGallery</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\installer\GameGallery.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <Product>GameGallery</Product>
    <AssemblyTitle>游戏截图图库</AssemblyTitle>
    <Version>1.0.3</Version>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <!-- 更新日志窗口：Markdig 负责解析 CHANGELOG.md，渲染成 WinUI 元素由 MarkdownRenderer 做 -->
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      运行时窗口图标：未打包的 WinUI 3 应用不会自动沿用 EXE 内嵌图标，
      必须由程序显式设置，否则标题栏/任务栏显示的是 Windows App SDK 默认图标。
    -->
    <Content Include="..\..\installer\GameGallery.ico" Link="Assets\GameGallery.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
